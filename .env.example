# Copy to .env for running on your own machine:   cp .env.example .env
# (On GitHub Actions these go into Settings -> Secrets and variables -> Actions instead.)
# Never commit a real .env file.

# ---- required ---------------------------------------------------------------
MAIL_TO=you@example.com              # where the reports go (comma-separate for several)
SMTP_USER=you@gmail.com              # the Gmail address that sends the mail
SMTP_PASS=xxxx xxxx xxxx xxxx        # a Gmail *App Password* (not your normal password)

# ---- optional ---------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=                         # defaults to SMTP_USER
# REGION=ON                          # province code used for prices and availability
# NOTIFY_ON=new,price_drop,restock   # also available: removed, price_increase
# MIN_PRICE_DROP=1                   # CAD; smaller drops are ignored
# BASELINE_EMAIL=true                # email the starting snapshot on the first run
# REPORT_TZ=Asia/Kolkata             # time zone shown in the emails
# POLL_INTERVAL_SECONDS=120          # only for `npm run watch`
# MAX_PAGES=40                       # safety stop for the "Show more" pages (24 laptops each)
# MIN_COVERAGE_PERCENT=90            # fail the check if the site returns less than this share of its own total
# API_URL=                           # advanced: the "search?" request copied from your browser's DevTools
