{
  "name": "bestbuy-laptop-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Watches the Best Buy Canada open-box / refurbished gaming-laptop listing and emails a comparison report when something new shows up.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "watch": "node --env-file-if-exists=.env src/index.js --watch",
    "preview": "node --env-file-if-exists=.env src/index.js --preview",
    "dump-raw": "node --env-file-if-exists=.env src/index.js --dump-raw",
    "test-email": "node --env-file-if-exists=.env src/index.js --test-email",
    "demo": "node test/demo.js",
    "test": "node test/run-tests.js"
  },
  "dependencies": {
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1"
  }
}
